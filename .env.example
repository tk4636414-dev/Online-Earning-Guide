# Copy these variables into Vercel Project Settings > Environment Variables.
# Do not commit the real values or put server-only values in client-side code.

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Firebase Admin SDK (server-side only)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_admin_client_email
# Keep the literal \\n sequences when pasting this value into Vercel.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY\\n-----END PRIVATE KEY-----\\n"
ADMIN_EMAIL=admin@example.com
# Optional comma-separated list of verified Firebase user emails allowed to send admin email.
ADMIN_EMAILS=

# Lemon Squeezy
# Card plans map weekly/monthly/annual to the 7-day/30-day/1-year variants below.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_WEBHOOK_SIGNING_SECRET=your_lemonsqueezy_webhook_signing_secret
LEMON_VARIANT_7_DAYS=your_7_day_variant_id
LEMON_VARIANT_15_DAYS=your_15_day_variant_id
LEMON_VARIANT_30_DAYS=your_30_day_variant_id
LEMON_VARIANT_90_DAYS=your_90_day_variant_id
LEMON_VARIANT_1_YEAR=your_1_year_variant_id
LEMON_VARIANT_3_YEARS=your_3_year_variant_id

# Vercel Cron authentication
# Use the same randomly generated value in Vercel and the cron request.
CRON_SECRET=your_vercel_cron_secret

# Contact form SMTP delivery (server-side only)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
CONTACT_EMAIL=your_destination_email
# Optional: must be an address accepted by your SMTP provider.
CONTACT_FROM_EMAIL=your_smtp_username

# Resend email delivery (server-side only)
RESEND_API_KEY=
# Optional verified sender; defaults to onboarding@resend.dev for testing.
RESEND_FROM_EMAIL=

# Local development only; Vercel supplies its own runtime and URL.
PORT=3000
